{
  "name": "@asugan/expo-kit",
  "version": "0.5.4",
  "description": "Shared building blocks for Asugan Expo apps: RevenueCat subscriptions, a customizable paywall, Aptabase analytics and Sentry setup.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./customer-center": {
      "types": "./dist/customer-center.d.ts",
      "react-native": "./dist/customer-center.native.js",
      "default": "./dist/customer-center.js"
    },
    "./paywall": {
      "types": "./dist/paywall.d.ts",
      "default": "./dist/paywall.js"
    },
    "./purchase-success-modal": {
      "types": "./dist/purchase-success-modal.d.ts",
      "default": "./dist/purchase-success-modal.js"
    },
    "./analytics": {
      "types": "./dist/analytics.d.ts",
      "default": "./dist/analytics.js"
    },
    "./sentry": {
      "types": "./dist/sentry.d.ts",
      "default": "./dist/sentry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "react": ">=19.0.0 <20",
    "react-native": ">=0.81.0 <1",
    "react-native-purchases": ">=9.10.3 <10",
    "react-native-purchases-ui": ">=9.10.3 <10",
    "react-native-safe-area-context": ">=5.0.0 <6",
    "@aptabase/react-native": ">=0.6.0 <1",
    "@sentry/react-native": ">=7.11.0 <9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-purchases-ui": {
      "optional": true
    },
    "@aptabase/react-native": {
      "optional": true
    },
    "@sentry/react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aptabase/react-native": "0.6.0",
    "@sentry/react-native": "7.11.0",
    "@types/react": "~19.2.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-purchases": "9.10.3",
    "react-native-purchases-ui": "9.10.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
